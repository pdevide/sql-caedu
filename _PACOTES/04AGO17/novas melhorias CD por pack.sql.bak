GO
ALTER TABLE PDA_WMS_TB_RESERVA_DISTRIBUICAO ADD PACK
char(1)
GO

UPDATE R SET R.PACK=SUBSTRING(CAIXA,1,1) FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO R
INNER JOIN PDA_WMS_TB_DISTRIBUICAO_COLETA C ON C.DISTRIBUICAO=R.DISTRIBUICAO AND R.PRODUTO=C.PRODUTO
WHERE SUBSTRING(CAIXA,1,1) <> '|'

GO
UPDATE R SET R.PACK=C.PACK FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO R
INNER JOIN PRODUTOS_PACKS_PERMITIDOS C ON C.PRODUTO=R.PRODUTO AND R.PRODUTO=C.PRODUTO

WHERE C.PACK IN('A','B') AND R.PACK IS NULL

GO

ALTER VIEW [dbo].[PDA_WMS_VW_SE_DISPONIBILIDADE_ESTOQUE]  
AS        
    
SELECT  AP.PRODUTO,
	    AP.PACK,            
        SUM(AP.QUANTIDADE)ESTOQUE,
		ISNULL(RD.QUANTIDADE,0) RESERVA,
		SUM(AP.QUANTIDADE) - ISNULL(RD.QUANTIDADE,0) DISPONIVEL
   FROM  PDA_WMS_TB_ARMAZENAGEM E 
   INNER JOIN PDA_WMS_TB_ARMAZENAGEM_PALETE AP ON AP.PALETE = E.PALETE
   LEFT JOIN (SELECT  SUM(QTDE) QUANTIDADE,PRODUTO,PACK FROM  PDA_WMS_TB_RESERVA_DISTRIBUICAO R INNER JOIN PDA_WMS_STATUS_DISTRIBUICAO S ON R.DISTRIBUICAO = S.DISTRIBUICAO WHERE STATUS IN(1,2,7) GROUP BY PRODUTO,PACK) RD ON RD.PRODUTO = AP.PRODUTO AND RD.PACK=AP.PACK
GROUP BY AP.PRODUTO,
         RD.QUANTIDADE,
		 AP.PACK

GO


ALTER PROCEDURE [dbo].[PDA_WMS_SP_IN_RESERVA_DISTRIBUICAO] --PDA_WMS_SP_IN_RESERVA_DISTRIBUICAO'D8010013',12,'0000004'
  @PRODUTO      CHAR(12),
  @QTDE         INT,     
  @DISTRIBUICAO CHAR(8),
  @PACK CHAR(1)  
AS     
  BEGIN     
      DECLARE @ID_ENDERECO            INT,     
              @QTDE_DISTRIBUICAO      INT,     
              @QTDE_DISPONIVEL        INT,     
              @QTDE_RESERVA           INT,              
              @QUANTIDADE             INT,   
              @QTDE_DISPONIVEL_NEW    INT,  
              @QTDE_RESERVAR_NEW      INT,  
              @QTDE_RESERVA_PARA_ENDERECO INT,  
              @QTDE_DISPONIVEL_ENDERECO INT     
    
      SET @QTDE_DISTRIBUICAO = @QTDE     
     
    
     
                      
     SELECT @QTDE_DISPONIVEL= (SUM(QTDE_ESTOQUE-QTDE))
	 FROM(
			SELECT   QTDE_ESTOQUE= QUANTIDADE,
					 ISNULL(RES.QTDE,0)  QTDE  
              FROM   (  SELECT   ID_ENDERECO,						      
								 SUM(QUANTIDADE)QUANTIDADE,
								 PRODUTO,
								 PACK						
					   FROM  PDA_WMS_TB_ARMAZENAGEM E 
					   INNER JOIN PDA_WMS_TB_ARMAZENAGEM_PALETE AP ON AP.PALETE = E.PALETE
					   WHERE  PRODUTO = @PRODUTO  AND PACK=@PACK  
					   GROUP BY ID_ENDERECO,PRODUTO,PACK
			         ) EST  
					  LEFT JOIN (SELECT PRODUTO,     
									    QTDE=SUM(QTDE),
										PACK    
								 FROM   PDA_WMS_TB_RESERVA_DISTRIBUICAO P     
									     LEFT JOIN PDA_WMS_STATUS_DISTRIBUICAO SP  ON SP.DISTRIBUICAO = P.DISTRIBUICAO     
										WHERE  PRODUTO = @PRODUTO   AND PACK=@PACK   
										AND SP.STATUS NOT IN( 3, 4, 5, 6 )     
										GROUP  BY PRODUTO,PACK 
								) RES  ON EST.PRODUTO = RES.PRODUTO AND RES.PACK=EST.PACK)RES

    
      IF( @QTDE_DISPONIVEL <= 0 )     
        SET @QTDE_RESERVA = 0     
    
      IF( @QTDE_DISTRIBUICAO > @QTDE_DISPONIVEL )     
        SET @QTDE_RESERVA = @QTDE_DISPONIVEL     
      ELSE     
        SET @QTDE_RESERVA = @QTDE_DISTRIBUICAO     
    
    
           
 SET @QTDE_RESERVA_PARA_ENDERECO =0;  
   
         --PRINT  'DISP'+ CAST (@QTDE_DISPONIVEL AS VARCHAR)       
         --PRINT 'RES'+ CAST (@QTDE_RESERVA AS VARCHAR)  
         --PRINT 'DISP E' + CAST ( @QTDE_RESERVA_PARA_ENDERECO  AS VARCHAR)                 
       
 BEGIN    
	          
	WHILE @QTDE_RESERVA > 0  
		BEGIN  
	    --PRINT 'AQUI'  + CAST ( @QTDE_RESERVA  AS VARCHAR)            
		  SET @ID_ENDERECO = (SELECT TOP 1 E.ID_ENDERECO FROM ( SELECT      ID_ENDERECO,
		  																    SUM( QUANTIDADE)QUANTIDADE,
																			 PRODUTO,
																			 PACK

																   FROM  PDA_WMS_TB_ARMAZENAGEM E 
																   INNER JOIN PDA_WMS_TB_ARMAZENAGEM_PALETE AP ON AP.PALETE = E.PALETE
																   GROUP BY ID_ENDERECO,PRODUTO,PACK
																) E   
														 INNER JOIN PDA_TB_ENDERECO EN ON E.ID_ENDERECO = E.ID_ENDERECO 
														WHERE  PRODUTO = @PRODUTO  AND PACK=@PACK   
														
														AND E.ID_ENDERECO NOT IN (SELECT DISTINCT ID_ENDERECO FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO WHERE DISTRIBUICAO=@DISTRIBUICAO AND PRODUTO=@PRODUTO  AND PACK=@PACK  )  
														ORDER BY QUANTIDADE DESC)  
	           
		  SELECT @QTDE_DISPONIVEL_ENDERECO = (SELECT  ( EST.QTDE_ESTOQUE - ISNULL(RES.QTDE, 0) )  DISP  
												FROM (SELECT PRODUTO,  
															 ID_ENDERECO,  
															 QUANTIDADE QTDE_ESTOQUE,
															 PACK   
													   FROM 													   
													   (SELECT      ID_ENDERECO,
		  															SUM( QUANTIDADE)QUANTIDADE,
																	PRODUTO,
																	PACK
																   FROM  PDA_WMS_TB_ARMAZENAGEM E 
																   INNER JOIN PDA_WMS_TB_ARMAZENAGEM_PALETE AP ON AP.PALETE = E.PALETE
																   GROUP BY ID_ENDERECO,PRODUTO,PACK
													   ) E) EST     
												 LEFT JOIN (SELECT PRODUTO,     
																   QTDE=SUM(QTDE)   
															FROM   PDA_WMS_TB_RESERVA_DISTRIBUICAO P     
															LEFT JOIN PDA_WMS_STATUS_DISTRIBUICAO SP  ON SP.DISTRIBUICAO = P.DISTRIBUICAO     
															 WHERE  PRODUTO = @PRODUTO AND P.ID_ENDERECO = @ID_ENDERECO   AND PACK=@PACK  
															 AND SP.STATUS NOT IN( 3, 4, 5, 6,11,12,13 ) -- TIRAR O COMENTARIO APÓS O TESTE    
															 GROUP  BY PRODUTO) RES  ON EST.PRODUTO = RES.PRODUTO  AND PACK=@PACK     
															 WHERE EST.ID_ENDERECO = @ID_ENDERECO AND EST.PRODUTO=@PRODUTO  AND PACK=@PACK  );  
	                       
	    
		IF(@ID_ENDERECO IS NOT NULL )  
		BEGIN 
			IF(@QTDE_DISPONIVEL_ENDERECO > @QTDE_RESERVA)
				BEGIN
					SET @QTDE_DISPONIVEL_ENDERECO = @QTDE_RESERVA
				END
				
					INSERT INTO PDA_WMS_TB_RESERVA_DISTRIBUICAO     
								(DISTRIBUICAO,     
								 ID_ENDERECO,     
								 PRODUTO,
								 QTDE,
								 PACK)     
					VALUES      (@DISTRIBUICAO,     
								 ISNULL(@ID_ENDERECO, 0),     
								 @PRODUTO, 
								 @QTDE_DISPONIVEL_ENDERECO,
								 @PACK )  
				

			  END    
			  SET  @QTDE_RESERVA = (@QTDE_RESERVA-@QTDE_DISPONIVEL_ENDERECO)  
		END   
		DELETE FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO WHERE QTDE <=0           
	END  
END 

GO


ALTER PROCEDURE [dbo].[PDA_WMS_SP_SE_PK_DISTRIBUICAO_COLETOR]--[PDA_WMS_SP_SE_PK_DISTRIBUICAO_COLETOR]'00000388'      
 @DISTRIBUICAO VARCHAR(12)      
AS      
BEGIN      
SELECT ISNULL(EN.ID_ENDERECO,0)ID_ENDERECO      
      ,ISNULL(EN.CONCATENADO,0) ENDERECO      
      ,R.PACK +'|'+R.PRODUTO  PRODUTO
      ,SUM(R.QTDE)QTDE      
      ,SUM(ISNULL(PC.QTDE,0))COLETA      
      ,SUM(R.QTDE) - SUM(ISNULL(PC.QTDE,0)) DIFERENCA,
	  R.PACK   
      
  FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO R       
  LEFT JOIN PDA_WMS_TB_ENDERECO EN ON EN.ID_ENDERECO = R.ID_ENDERECO    
      
  INNER JOIN (SELECT SUM(QUANTIDADE)QUANTIDADE,DISTRIBUICAO FROM PDA_WMS_TB_DISTRIBUICAO WHERE DISTRIBUICAO = @DISTRIBUICAO GROUP BY DISTRIBUICAO) P ON P.DISTRIBUICAO =R.DISTRIBUICAO      
  LEFT JOIN (SELECT DISTRIBUICAO,PRODUTO,SUM(QTDE)QTDE,ID_ENDERECO FROM  PDA_WMS_TB_DISTRIBUICAO_COLETA GROUP BY PRODUTO,ID_ENDERECO,DISTRIBUICAO) PC ON PC.DISTRIBUICAO = R.DISTRIBUICAO      
             AND PC.PRODUTO = R.PRODUTO      
                 
            AND PC.ID_ENDERECO = R.ID_ENDERECO 
                  
                  
  WHERE R.DISTRIBUICAO = @DISTRIBUICAO      
    
  AND   R.ID_ENDERECO NOT IN (SELECT L.ID_ENDERECO_ANTIGO FROM PDA_WMS_TB_RESERVA_DISTRIBUICAO L WHERE L.DISTRIBUICAO = @DISTRIBUICAO AND ID_ENDERECO_ANTIGO IS NOT NULL)       
 
  GROUP BY  EN.ID_ENDERECO       
     ,EN.CONCATENADO       
     ,R.PRODUTO
	 ,R.PACK         
     
            
  HAVING  (SUM(R.QTDE) - SUM( ISNULL(PC.QTDE,0))) > 0      
  ORDER BY CONCATENADO ASC
 END 
 GO

