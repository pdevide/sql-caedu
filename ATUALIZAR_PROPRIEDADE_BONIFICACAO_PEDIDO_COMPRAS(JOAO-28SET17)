FROM @PEDIDOS

SET @I = 1
SET @TOTINS = 0 
SET @TOTUPD = 0

WHILE @I <= @TOTAL
BEGIN
	SELECT @PEDIDO = PEDIDO, @VALOR_PROP = VALOR_PROP 
	FROM @PEDIDOS 
	WHERE ID = @I
	
	/*INFORMAÇÃO JÁ EXISTE - UPDATE*/
	IF EXISTS(SELECT 1 FROM PROP_COMPRAS WHERE PROPRIEDADE = '00093' AND PEDIDO = @PEDIDO)
	BEGIN
		
		UPDATE PROP_COMPRAS
		SET VALOR_PROPRIEDADE = @VALOR_PROP
		WHERE PROPRIEDADE = '00093' AND PEDIDO = @PEDIDO

		SET @TOTUPD = @TOTUPD + 1
	END
	ELSE
	/*INFORMAÇÃO NÃO EXISTE - INSERT*/
	BEGIN
		INSERT INTO PROP_COMPRAS (PROPRIEDADE,PEDIDO,ITEM_PROPRIEDADE,VALOR_PROPRIEDADE,DATA_PARA_TRANSFERENCIA)
		VALUES ('00093',@PEDIDO,1,@VALOR_PROP,NULL)

		SET @TOTINS = @TOTINS + 1
	END
		
	SET @I = @I + 1
END

